# ---------------------------------------------------------------------------
# DPC secrets & build noise (hardening — see FLAVOR_SYSTEM.md)
# NOTE: *.jks (line ~94) and *.log (line ~3) are already ignored above.
# ---------------------------------------------------------------------------

# Release signing secrets — read by build.gradle.kts, never committed.
android/app/keystore.properties

# Per-flavor Firebase config. Provided at build time (CI secret / local dev),
# never committed. The generator scaffolds a google-services.PLACEHOLDER.json
# marker instead; the real file is dropped in per client.
**/google-services.json

# Firebase Admin SDK service-account keys (server-side credentials).
**/*firebase-adminsdk*.json

# Kotlin incremental-compile error logs (thousands of build-noise files).
android/.kotlin/

# Server runtime data / operational state (node push server) — NOT source.
# fcm_tokens.json holds live device FCM push tokens; pending_policies.json is
# transient queue state; server.log is runtime noise (also caught by *.log).
fcm_tokens.json
pending_policies.json
server.log

# Flutter debug symbols dir (build output; individual app.*.symbols already ignored).
/debug-info/

# Per-flavor launcher icons — large client logo binaries (several MB each, ~86MB
# total). Provided per client at build time like google-services.json; each flavor
# falls back to the main/ icon otherwise. The main/default icon IS kept.
android/app/src/*/res/mipmap-*/ic_launcher.png
android/app/src/*/res/mipmap-*/ic_launcher.jpg
android/app/src/*/res/mipmap-*/ic_launcher.jpeg
!android/app/src/main/res/mipmap-*/ic_launcher.png
!android/app/src/main/res/mipmap-*/ic_launcher.jpg
!android/app/src/main/res/mipmap-*/ic_launcher.jpeg

