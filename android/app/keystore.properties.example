# Template for android/app/keystore.properties (the real file is git-ignored).
# Copy this to `keystore.properties` and fill in the real signing secrets.
# In CI, provide these via secrets instead of a checked-in file.
#
# storeFile is resolved relative to android/app/ (where build.gradle.kts lives).
storeFile=your-release-keystore.jks
storePassword=CHANGE_ME
keyAlias=your-key-alias
keyPassword=CHANGE_ME
